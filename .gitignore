# Root .gitignore for the In-Browser Data Workbench monorepo.
# App-specific rules live in apps/*/.gitignore; this covers everything shared
# plus formats we never want committed regardless of where they land.

# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
# Never commit real environment files; the *.example templates are tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python (apps/api)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Node / Next.js (apps/web)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
coverage/
.pnpm-store/

# Self-hosted DuckDB bundle + extensions — regenerated by scripts/copy-duckdb.mjs
public/duckdb/

# ---------------------------------------------------------------------------
# Data files — this is a data tool; keep sample/real data out of the repo.
# Commit an intentional fixture with an explicit override, e.g.
#   git add -f apps/web/tests/fixtures/small.csv
# ---------------------------------------------------------------------------
*.csv
*.tsv
*.parquet
*.pq
*.xlsx
*.xls
*.ndjson
*.duckdb
*.duckdb.wal
*.arrow
*.feather
# JSON is a config format too, so ignore it only under data/ directories.
data/*.json
**/data/*.json

# ---------------------------------------------------------------------------
# Build & logs
# ---------------------------------------------------------------------------
dist/
build/
*.log
npm-debug.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# OS & editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

*.md
