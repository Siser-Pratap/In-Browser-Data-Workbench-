# Copy to .env and fill in what you need:
#
#   cp .env.example .env
#
# Everything here is optional. `docker compose up` works with an empty .env —
# the stack comes up, the workbench is fully usable, and only the features whose
# credentials are missing stay switched off.
#
# Non-secret dev settings (database URL, JWT secret, CORS origins, MinIO
# credentials) live in docker-compose.yml rather than here, so that a fresh
# clone runs with no setup at all. This file is only for the things that are
# yours.

# --- AI ---------------------------------------------------------------------
# Required for the /api/v1/ai/* endpoints (NL→SQL, insights, analyst chat).
# Without one the rest of the API is unaffected and only those endpoints are
# unavailable. Get a key at https://aistudio.google.com/apikey
#
# TWO KEYS, PICKED BY ENVIRONMENT. `docker compose up` runs as
# ENVIRONMENT=development, so it spends GEMINI_API_KEY_DEV. GEMINI_API_KEY is
# the production key and is NOT used as a fallback — a dev machine can never
# quietly bill production. If AI reports itself unconfigured while running
# locally, it is GEMINI_API_KEY_DEV that is missing.

# Used when ENVIRONMENT=development (the local Docker stack).
GEMINI_API_KEY_DEV=

# Used when ENVIRONMENT=production (the default when unset).
GEMINI_API_KEY=

# The backend's own default is the `gemini-flash-latest` alias, which tracks the
# current Flash model — pinned ids eventually return "no longer available to new
# users", which surfaces as `model_not_found`. Pin an explicit id here if you
# need reproducibility, or point at a Pro model for stronger reasoning (note
# that Pro has much tighter free-tier quota).
AI_MODEL=gemini-flash-latest

# Per-user daily token ceiling for the AI endpoints.
AI_DAILY_TOKEN_BUDGET=200000

# --- Object storage ---------------------------------------------------------
# Bucket for opt-in raw dataset uploads. Created automatically in MinIO by the
# minio-init service. Leave as-is unless you're pointing at real S3.
S3_BUCKET=workbench-dev

# --- OAuth (optional) -------------------------------------------------------
# Each provider activates only when both its id and secret are set; otherwise
# the sign-in page simply doesn't offer it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
