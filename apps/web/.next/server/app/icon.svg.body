<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" role="img" aria-label="Data Workbench">
  <rect width="32" height="32" rx="7" fill="#1b1e26"/>
  <!-- A stack of table rows: the product is a grid of data, and the mark should
       read at 16px without any detail that disappears there. -->
  <g fill="#5b93e8">
    <rect x="7" y="8" width="18" height="4" rx="1.5"/>
    <rect x="7" y="14" width="18" height="4" rx="1.5" opacity="0.72"/>
    <rect x="7" y="20" width="11" height="4" rx="1.5" opacity="0.45"/>
  </g>
</svg>
